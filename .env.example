# Token PÚBLICO do Mapbox (usado pelo front-end em web/)
VITE_MAPBOX_ACCESS_TOKEN=seu_token_publico_do_mapbox

# auto   = usa models/pipeline.pkl se existir; senão, dados simulados (padrão)
# mock   = sempre dados simulados
# modelo = exige o modelo treinado
MODO_PREDITOR=auto

# Opcionais (padrões abaixo)
# PASTA_MODELO=models
# CAMINHO_AMOSTRA=data/amostra_enem_2023.parquet

# Banco de dados (usuários e histórico). Sem DATABASE_URL, usa o SQLite em data/edupredict.db.
# No Render, use a "Internal Database URL" do Postgres gratuito.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Segredo dos tokens de login. OBRIGATÓRIO em produção: gere com
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# HORAS_TOKEN=8

# Primeiro usuário, criado só quando o banco está vazio. Troque a senha em produção.
# ADMIN_EMAIL=coordenacao@edupredict.dev
# ADMIN_SENHA=edupredict123
# ADMIN_NOME=Coordenação pedagógica
