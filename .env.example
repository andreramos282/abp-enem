# Token PÚBLICO do Mapbox (usado pelo front-end em web/)
VITE_MAPBOX_ACCESS_TOKEN=seu_token_publico_do_mapbox

# auto   = usa models/pipeline.pkl se existir; senão, dados simulados (padrão)
# mock   = sempre dados simulados
# modelo = exige o modelo treinado
MODO_PREDITOR=auto

